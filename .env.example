# Server-side GitHub PAT (app owner's token).
# Used as a fallback for visitors who haven't connected their own GitHub
# account, raising the shared rate limit from 60 to 5,000 req/h.
# Never exposed to the browser — requests are proxied through a server fn.
# Create one at https://github.com/settings/tokens/new?scopes=public_repo
GITHUB_TOKEN=

# Optional: enables the "Sign in with GitHub" button (OAuth Device Flow).
# Create an OAuth App at https://github.com/settings/applications/new
# (any callback URL works — device flow doesn't use it), then tick
# "Enable Device Flow" in the app settings and paste the Client ID here.
# No client secret is needed for device flow.
GITHUB_OAUTH_CLIENT_ID=
